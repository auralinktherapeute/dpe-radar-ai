{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@domain/*": [
        "../src/domain/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/domain/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}