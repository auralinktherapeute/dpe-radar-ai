# Build stage
FROM rust:1.75-slim as builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    clang \
    llvm-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace
COPY Cargo.toml Cargo.lock ./
COPY obscura-dpe ./obscura-dpe
COPY workers ./workers
COPY obscura-client ./obscura-client

# Build release binary with optimizations
RUN RUSTFLAGS="-C target-cpu=native" \
    cargo build --release --locked -p dpe-radar-workers \
    && strip target/release/dpe-radar-workers

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy binary from builder
COPY --from=builder /build/target/release/dpe-radar-workers /usr/local/bin/

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Environment
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1

CMD ["dpe-radar-workers"]
