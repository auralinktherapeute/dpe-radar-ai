# Persistance des leads (Supabase). Sans ces deux variables, les leads
# tombent dans un fichier local, perdu au redemarrage sur Render.
SUPABASE_URL=https://dqmujlqxpmcwscztrrdt.supabase.co
SUPABASE_ANON_KEY=          # cle publishable, a definir dans Render

# Consultation des leads (donnees personnelles). Sans ADMIN_TOKEN, la
# consultation est desactivee ; le dashboard public ne montre jamais de contact.
# Le jeton est verifie par la base elle-meme (seule son empreinte SHA-256 y
# est stockee). Aucune cle service_role n'est necessaire.
ADMIN_TOKEN=

# Adresse publique du service, imprimee sur les courriers
DPE_SITE=https://dpe-radar-ai.onrender.com

# Rafraichissement automatique ADEME
ADEME_AUTO_REFRESH=1
ADEME_REFRESH_JOURS=7
ADEME_DEPARTEMENTS=67,68
